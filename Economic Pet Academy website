                wishBtn.disabled = false;
                wishBtn.className = "mt-4 w-full py-3 rounded-xl font-black text-xs sm:text-sm bg-gradient-to-r from-purple-600 to-pink-600 hover:from-purple-700 hover:to-pink-700 text-white shadow-md transition transform hover:-translate-y-0.5";
                wishBtn.textContent = `✨ 滿足寵物心願！Fulfill Request (已達 ${stu.score}/${wish.req} 分)`;
            } else {
                wishBtn.disabled = true;
                wishBtn.className = "mt-4 w-full py-3 rounded-xl font-bold text-xs sm:text-sm bg-slate-200 text-slate-500 cursor-not-allowed";
                wishBtn.textContent = `🔒 積分不足，還差 ${wish.req - stu.score} 分 (Need ${wish.req} pts)`;
