        function enterLockedStudentMode(studentId, silent = false) {
            const stu = appState.students.find(s => s.id === studentId);
            if (!stu) return;

            currentRole = "student";
            lockedStudentId = studentId;
            sessionStorage.setItem(SESSION_LOCK_KEY, studentId);
            localStorage.setItem(SESSION_LOCK_KEY, studentId);

            // Lock top bar to ONLY this student (no dropdown switcher)
            updateTopNavForStudent(stu);
            document.getElementById("nav-student-locked").classList.remove("hidden");
            document.getElementById("nav-student-locked").classList.add("flex");
            document.getElementById("btn-open-teacher").classList.remove("hidden");
            document.getElementById("btn-exit-teacher").classList.add("hidden");

            if (!silent) {
                showToast(`已鎖定學生帳號：${stu.name}`, `Locked to Student: ${stu.name}`, "🔒");
