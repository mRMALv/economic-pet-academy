            document.getElementById("stat-hunger-bar").style.width = `${stu.hunger}%`;
            document.getElementById("stat-clean-text").textContent = `${stu.cleanliness}%`;
            document.getElementById("stat-clean-bar").style.width = `${stu.cleanliness}%`;
            document.getElementById("stat-happy-text").textContent = `${stu.happiness}%`;
            document.getElementById("stat-happy-bar").style.width = `${stu.happiness}%`;

            // 4 Score-Gated Care Buttons
            const actions = [
                { key: "pet", icon: "✋", zh: "撫摸", en: "Pet / Pat", req: 0, color: "from-amber-400 to-orange-500" },
                { key: "feed", icon: "🍙", zh: "餵食", en: "Feed", req: 5, color: "from-emerald-500 to-green-600" },
                { key: "bathe", icon: "🛁", zh: "洗澡", en: "Bathe", req: 10, color: "from-sky-500 to-blue-600" },
                { key: "play", icon: "🎾", zh: "玩耍", en: "Play", req: 15, color: "from-purple-500 to-pink-600" }
            ];

            document.getElementById("care-buttons-grid").innerHTML = actions.map(act => {
                const unlocked = stu.score >= act.req;
                return `
                    <button onclick="interactCare('${act.key}')"
                        class="p-3.5 rounded-2xl border-2 transition flex flex-col items-center justify-center text-center relative ${unlocked
                            ? `bg-gradient-to-br ${act.color} text-white border-transparent shadow-md hover:scale-[1.03] active:scale-95`
