                return;
            }
            appState.students.push({
                id: "stu_" + Date.now(),
                name: name,
                petCreated: false,
                petId: null,
                conceptZH: "",
                conceptEN: "",
                adjZH: "",
                adjEN: "",
                score: 0,
                hunger: 50,
                cleanliness: 50,
                happiness: 60,
                habitat: "meadow",
                wishId: "w5",
                fulfilledCount: 0
            });
            nameInput.value = "";
            persistState();
            renderTeacherAdmin();
            showToast(`已新增學生：${name}`, `Added student: ${name}`, "✅");
        }

        function adminAdjustScore(studentId, delta, reason) {
            const stu = appState.students.find(s => s.id === studentId);
            if (!stu) return;

            const numericDelta = parseInt(delta, 10);
            if (isNaN(numericDelta) || numericDelta === 0) {
                showToast("請輸入有效的非零整數分數！", "Enter a valid non-zero integer!", "⚠️");
                return;
            }

            stu.score = Math.max(0, (stu.score || 0) + numericDelta);

            const now = new Date();
            const timeStr = `${String(now.getHours()).padStart(2, "0")}:${String(now.getMinutes()).padStart(2, "0")}`;

            appState.logs.unshift({
                id: "log_" + Date.now(),
                studentId: stu.id,
                studentName: stu.name,
                delta: numericDelta,
                reason: reason || (numericDelta > 0 ? "課堂表現優良 Good Performance" : "課堂扣分 Deduction"),
                time: timeStr
            });
            if (appState.logs.length > 50) appState.logs.pop();

            persistState();
            renderTeacherAdmin();
            showToast(
                `${stu.name} ${numericDelta >= 0 ? '+' + numericDelta : numericDelta} 分 (${reason})`,
                `Updated ${stu.name}'s score`,
                numericDelta >= 0 ? "🌟" : "📉"
            );
        }

        function adminApplyCustomScore(studentId) {
            const ptsInput = document.getElementById(`custom-pts-${studentId}`);
            const reasonInput = document.getElementById(`custom-reason-${studentId}`);
            const delta = parseInt(ptsInput.value, 10);
            const reason = reasonInput.value.trim() || (delta >= 0 ? "老師特別加分 Custom Bonus" : "老師特別扣分 Custom Deduction");
            adminAdjustScore(studentId, delta, reason);
        }

        function adminTriggerStudentWish(studentId) {
            const stu = appState.students.find(s => s.id === studentId);
            if (!stu) return;
            const others = WISH_POOL.filter(w => w.id !== stu.wishId);
            const next = others[Math.floor(Math.random() * others.length)];
            stu.wishId = next.id;
            persistState();
            renderTeacherAdmin();
            showToast(`已為 ${stu.name} 發送新寵物心願：${next.zh}`, `Sent wish to ${stu.name}`, "💌");
        }

        function triggerClassWideRequest() {
            appState.students.forEach(stu => {
                const others = WISH_POOL.filter(w => w.id !== stu.wishId);
                stu.wishId = others[Math.floor(Math.random() * others.length)].id;
            });
            persistState();
            renderTeacherAdmin();
            showToast("已向全班所有寵物發送隨機新心願！", "Broadcasted random requests to entire class!", "📢");
        }

        function renderTeacherAdmin() {
            document.getElementById("admin-total-students").textContent = `${appState.students.length} 位學生`;

            const listEl = document.getElementById("admin-students-list");
            listEl.innerHTML = appState.students.map(stu => {
                const pet = stu.petCreated ? PET_SPECIES.find(p => p.id === stu.petId) : null;
                const pInfo = pet ? PERSONALITIES[pet.personality] : { badge: 'bg-slate-100 text-slate-500', zh: '未知', en: 'Unknown' };
                const wish = WISH_POOL.find(w => w.id === stu.wishId) || WISH_POOL[0];
                const petTitle = stu.petCreated ? `${stu.adjZH}${stu.conceptZH} · ${stu.adjEN} ${stu.conceptEN}` : "尚未命名與選擇寵物 Not Adopted Yet";
                const petIcon = pet ? getChibiPetSVG(pet.id, stu.score >= 5 ? 'happy' : 'neutral') : '<div class="text-3xl text-center mt-2">🥚</div>';

                return `
                    <div class="bg-white rounded-3xl shadow-md p-5 border border-slate-200/80 space-y-4">
                        <!-- Top Info Row -->
                        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                            <div class="flex items-center gap-3.5">
                                <div class="w-14 h-14 rounded-2xl bg-amber-50 border border-amber-200 p-1 shrink-0">
                                    ${petIcon}
                                </div>
                                <div>
                                    <div class="flex items-center flex-wrap gap-2">
                                        <h4 class="text-base font-black text-slate-800">${escapeHTML(stu.name)}</h4>
                                        <span class="px-2.5 py-0.5 rounded-full text-[11px] font-extrabold ${pInfo.badge}">
                                            ${pet ? pet.nameZH : '尚未選擇'} (${pInfo.zh} ${pInfo.en})
                                        </span>
                                    </div>
                                    <p class="text-xs font-bold text-indigo-700 mt-0.5">${escapeHTML(petTitle)}</p>
                                    <p class="text-[11px] text-slate-500 mt-0.5">💌 目前心願：${wish.zh} (需 ${wish.req} 分)</p>
                                </div>
                            </div>

                            <div class="flex items-center gap-2 self-end sm:self-center">
                                <button onclick="adminTriggerStudentWish('${stu.id}')" title="發送新寵物心願"
                                    class="px-3 py-2 rounded-xl bg-purple-50 hover:bg-purple-100 text-purple-700 border border-purple-200 text-xs font-extrabold transition">
                                    💌 換心願
                                </button>
                                <div class="px-4 py-2 rounded-2xl bg-amber-400 text-amber-950 font-black text-base shadow-xs">
                                    ${stu.score} 分
                                </div>
                            </div>
                        </div>

                        <!-- Quick One-Click Score Buttons -->
                        <div class="flex flex-wrap items-center gap-1.5 pt-2 border-t border-slate-100">
                            <span class="text-[11px] font-extrabold text-slate-500 mr-1">⚡ 快捷評分 Quick:</span>
                            <button onclick="adminAdjustScore('${stu.id}', 2, '積極回答 Active Answer')"
                                class="px-2.5 py-1.5 rounded-xl bg-emerald-500 hover:bg-emerald-600 text-white text-xs font-extrabold transition shadow-2xs">
                                +2 積極回答
                            </button>
                            <button onclick="adminAdjustScore('${stu.id}', 5, '經濟學神分析 Great Econ Insight')"
                                class="px-2.5 py-1.5 rounded-xl bg-teal-600 hover:bg-teal-700 text-white text-xs font-extrabold transition shadow-2xs">
                                +5 神分析
                            </button>
                            <button onclick="adminAdjustScore('${stu.id}', 10, '小組優勝 Team Winner')"
                                class="px-2.5 py-1.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-extrabold transition shadow-2xs">
                                +10 小組優勝
                            </button>
                            <button onclick="adminAdjustScore('${stu.id}', -2, '分心聊天 Distracted')"
                                class="px-2.5 py-1.5 rounded-xl bg-amber-600 hover:bg-amber-700 text-white text-xs font-extrabold transition shadow-2xs">
                                -2 分心聊天
                            </button>
                            <button onclick="adminAdjustScore('${stu.id}', -5, '未交功課 Missing Work')"
                                class="px-2.5 py-1.5 rounded-xl bg-rose-600 hover:bg-rose-700 text-white text-xs font-extrabold transition shadow-2xs">
                                -5 未交功課
                            </button>
                        </div>

                        <!-- Custom Score & Reason Input -->
                        <div class="bg-slate-50 rounded-2xl p-3 border border-slate-200/80 flex flex-col sm:flex-row items-stretch sm:items-center gap-2">
                            <span class="text-[11px] font-extrabold text-slate-600 shrink-0">✏️ 自訂加減分:</span>
                            <input id="custom-pts-${stu.id}" type="number" value="3" placeholder="分數 (+3 / -3)"
                                class="w-full sm:w-24 px-3 py-1.5 rounded-xl border border-slate-300 bg-white text-xs font-black text-center focus:outline-none focus:border-indigo-500">
                            <input id="custom-reason-${stu.id}" type="text" placeholder="輸入加減分理由 (例如：幫助同學解釋邊際成本)"
                                class="flex-1 px-3 py-1.5 rounded-xl border border-slate-300 bg-white text-xs font-bold focus:outline-none focus:border-indigo-500">
                            <button onclick="adminApplyCustomScore('${stu.id}')"
                                class="px-4 py-1.5 rounded-xl bg-slate-800 hover:bg-slate-900 text-white text-xs font-black transition shrink-0">
                                確認調整 Apply
                            </button>
                        </div>
                    </div>
                `;
            }).join("");

            // Render Live Class Activity Log
            const logBox = document.getElementById("admin-activity-log");
            if (appState.logs.length === 0) {
                logBox.innerHTML = `<p class="text-slate-400 text-center py-6">尚無積分異動紀錄</p>`;
            } else {
                logBox.innerHTML = appState.logs.map(l => `
                    <div class="p-3 rounded-2xl bg-slate-50 border border-slate-100 flex items-center justify-between gap-2">
                        <div class="min-w-0">
                            <p class="font-black text-slate-800 truncate">${escapeHTML(l.studentName)}</p>
                            <p class="text-[11px] text-slate-600 truncate">${escapeHTML(l.reason)}</p>
                            <p class="text-[10px] text-slate-400">${l.time}</p>
                        </div>
                        <span class="px-2.5 py-1 rounded-xl font-black shrink-0 ${l.delta >= 0 ? 'bg-emerald-100 text-emerald-700' : 'bg-rose-100 text-rose-700'}">
                            ${l.delta >= 0 ? '+' + l.delta : l.delta} 分
                        </span>
                    </div>
                `).join("");
            }
        }

        // =====================================================================
        // 🛠️ UTILITIES
        // =====================================================================
        let toastTimer = null;
        function showToast(zh, en, icon = "✨") {
            const box = document.getElementById("toast-box");
            document.getElementById("toast-icon").textContent = icon;
            document.getElementById("toast-zh").textContent = zh;
            document.getElementById("toast-en").textContent = en;
            box.classList.remove("hidden");
            clearTimeout(toastTimer);
            toastTimer = setTimeout(() => box.classList.add("hidden"), 3200);
        }

        function escapeHTML(str) {
            return String(str || "")
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;");
        }
    </script>
</body>
</html>
