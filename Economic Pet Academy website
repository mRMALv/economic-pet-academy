                        <span class="mt-1 px-2 py-0.5 rounded-full text-[10px] font-extrabold ${unlocked ? 'bg-black/20 text-white' : 'bg-slate-200 text-slate-600'}">
                            ${act.req === 0 ? '免費 Free (0分)' : unlocked ? `已解鎖 ≥${act.req}分` : `需滿 ${act.req} 分`}
