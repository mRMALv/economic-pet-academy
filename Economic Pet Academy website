<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>經濟學萌寵學院 | Economic Pet Academy</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Firebase Realtime Database Compat SDKs (CDN) -->
    <script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-database-compat.js"></script>
    <!-- Google Fonts: Inter & Noto Sans TC -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Noto+Sans+TC:wght@400;500;700;900&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', 'Noto Sans TC', sans-serif;
            overflow-x: hidden;
        }
        @keyframes petFloat {
            0%, 100% { transform: translateY(0px) scale(1); }
            50% { transform: translateY(-9px) scale(1.02); }
        }
        @keyframes petJump {
            0%, 100% { transform: translateY(0) scale(1, 1); }
            30% { transform: translateY(-28px) scale(0.95, 1.07); }
            60% { transform: translateY(0) scale(1.06, 0.93); }
            80% { transform: translateY(-10px) scale(0.98, 1.02); }
        }
        @keyframes petWiggle {
            0%, 100% { transform: rotate(0deg); }
            25% { transform: rotate(-6deg); }
            75% { transform: rotate(6deg); }
        }
        @keyframes particleRise {
            0% { opacity: 1; transform: translateY(0) scale(0.7); }
            100% { opacity: 0; transform: translateY(-90px) scale(1.35); }
        }
        .animate-pet-float { animation: petFloat 3s ease-in-out infinite; }
        .animate-pet-jump { animation: petJump 0.75s ease-in-out; }
        .animate-pet-wiggle { animation: petWiggle 0.45s ease-in-out 2; }
        .animate-particle { animation: particleRise 1.2s ease-out forwards; }

        /* Scenic Habitat Themes */
        .bg-meadow {
            background: linear-gradient(180deg, #bae6fd 0%, #e0f2fe 52%, #86efac 52%, #4ade80 100%);
        }
        .bg-woodroom {
            background: linear-gradient(180deg, #fef3c7 0%, #fde68a 58%, #d97706 58%, #b45309 100%);
        }
        .bg-sakura {
            background: linear-gradient(180deg, #fce7f3 0%, #fbcfe8 54%, #f9a8d4 54%, #86efac 100%);
        }
        .bg-starry {
            background: linear-gradient(180deg, #0f172a 0%, #1e1b4b 58%, #064e3b 58%, #022c22 100%);
        }
        .bg-beach {
            background: linear-gradient(180deg, #7dd3fc 0%, #38bdf8 46%, #0284c7 46%, #0284c7 58%, #fde047 58%, #facc15 100%);
        }
    </style>
</head>
<body class="bg-amber-50/70 text-slate-800 min-h-screen flex flex-col">

    <!-- =========================================================================
         TOP NAVIGATION BAR
    ========================================================================== -->
    <header class="bg-white/95 backdrop-blur-md border-b border-amber-200/80 sticky top-0 z-40 shadow-sm">
        <div class="max-w-7xl mx-auto px-4 py-3 flex flex-wrap items-center justify-between gap-3">
            <!-- Brand Title -->
            <div class="flex items-center space-x-3">
                <div class="w-10 h-10 rounded-2xl bg-gradient-to-br from-amber-400 to-orange-500 flex items-center justify-center text-white text-xl shadow-md">
                    🐾
                </div>
                <div>
                    <h1 class="text-base sm:text-lg font-black tracking-tight text-slate-800 leading-tight">
                        經濟學萌寵學院 <span class="text-amber-600 hidden sm:inline">| Economic Pet Academy</span>
                    </h1>
                    <p class="text-[11px] text-slate-500 font-medium">互動課堂積分養成系統 · Interactive Econ Gamification</p>
                </div>
            </div>

            <!-- Right Controls: Cloud Status + Locked Student Pill / Teacher Switcher -->
            <div class="flex items-center flex-wrap gap-2 sm:gap-3">
                <!-- Sync Status Pill -->
                <div id="sync-status-pill" class="flex items-center space-x-1.5 px-3 py-1 rounded-full text-xs font-bold border bg-slate-100 border-slate-200 text-slate-600">
                    <span id="sync-dot" class="w-2 h-2 rounded-full bg-amber-500"></span>
                    <span id="sync-text">本機展示模式 Local Demo</span>
                </div>

                <!-- Locked Student Session Badge (Shown ONLY when logged in as Student - NO switcher!) -->
                <div id="nav-student-locked" class="hidden items-center gap-2 bg-emerald-50 border border-emerald-200 px-3 py-1.5 rounded-2xl">
                    <span class="text-xs font-black text-emerald-800" id="nav-student-label">🔒 學生：--</span>
                    <span class="px-2 py-0.5 bg-amber-400 text-amber-950 rounded-full text-xs font-black" id="nav-student-score">0 分</span>
                    <button onclick="logoutRole()" class="ml-1 px-2.5 py-1 bg-rose-500 hover:bg-rose-600 text-white rounded-xl text-xs font-bold transition shadow-xs">
                        登出 Logout
                    </button>
                </div>

                <!-- Teacher Admin Badge / Button -->
                <div id="nav-teacher-controls" class="flex items-center gap-2">
                    <button id="btn-open-teacher" onclick="openTeacherPasscodeModal()" class="px-3.5 py-2 rounded-2xl bg-indigo-600 hover:bg-indigo-700 text-white text-xs sm:text-sm font-extrabold shadow-sm transition flex items-center gap-1.5">
                        <span>🔐 老師後台</span>
                        <span class="hidden sm:inline opacity-90">Teacher Admin</span>
                    </button>
                    <button id="btn-exit-teacher" onclick="logoutRole()" class="hidden px-3.5 py-2 rounded-2xl bg-rose-600 hover:bg-rose-700 text-white text-xs sm:text-sm font-extrabold shadow-sm transition">
                        🔒 鎖定離開後台 Lock & Exit
                    </button>
                </div>
            </div>
        </div>
    </header>

    <!-- =========================================================================
         GLOBAL TOAST NOTIFICATION
    ========================================================================== -->
    <div id="toast-box" class="fixed bottom-5 right-5 z-50 hidden transform transition-all duration-300 max-w-sm">
        <div class="bg-slate-900/95 text-white px-4 py-3 rounded-2xl shadow-2xl border border-slate-700 flex items-center gap-3">
            <span id="toast-icon" class="text-2xl">✨</span>
            <div>
                <p id="toast-zh" class="text-sm font-bold leading-snug"></p>
                <p id="toast-en" class="text-xs text-slate-300 leading-snug"></p>
            </div>
        </div>
    </div>

    <!-- =========================================================================
         TEACHER PASSCODE MODAL (Default: 8888)
    ========================================================================== -->
    <div id="teacher-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-900/60 backdrop-blur-sm p-4">
        <div class="bg-white rounded-3xl shadow-2xl max-w-md w-full p-6 sm:p-8 border border-indigo-100">
            <div class="text-center mb-5">
                <div class="w-14 h-14 bg-indigo-100 text-indigo-600 rounded-2xl flex items-center justify-center text-3xl mx-auto mb-3">
                    👩‍🏫
                </div>
                <h2 class="text-xl font-black text-slate-800">老師後台密碼驗證</h2>
                <p class="text-xs text-slate-500 mt-1">Teacher Admin Passcode Required</p>
            </div>
            <div class="space-y-4">
                <div>
                    <label class="block text-xs font-extrabold text-slate-700 mb-1.5">請輸入管理密碼 / Enter Passcode</label>
                    <input id="teacher-passcode-input" type="password" placeholder="••••"
                        onkeydown="if(event.key==='Enter') verifyTeacherPasscode()"
                        class="w-full px-4 py-3 rounded-2xl border-2 border-slate-200 focus:border-indigo-500 focus:outline-none text-center text-xl font-black tracking-widest">
                    <p id="teacher-passcode-error" class="hidden text-xs font-bold text-rose-600 text-center mt-2">
                        ❌ 密碼錯誤，請再試一次！ / Incorrect passcode!
                    </p>
                    <p class="text-[11px] text-slate-400 text-center mt-2">預設密碼 Default Passcode: <span class="font-mono font-bold text-slate-600">8888</span></p>
                </div>
                <div class="grid grid-cols-2 gap-3 pt-1">
                    <button onclick="closeTeacherPasscodeModal()" class="py-3 rounded-2xl border border-slate-200 text-slate-600 font-bold text-xs hover:bg-slate-50 transition">
                        取消 Cancel
                    </button>
                    <button onclick="verifyTeacherPasscode()" class="py-3 rounded-2xl bg-indigo-600 hover:bg-indigo-700 text-white font-black text-xs shadow-md transition">
                        確認進入 Unlock →
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- =========================================================================
         MAIN VIEWPORT CONTAINER
    ========================================================================== -->
    <main class="flex-1 max-w-7xl w-full mx-auto px-4 py-6">

        <!-- =====================================================================
             1. LANDING / LOGIN SCREEN (Student Lock Gate vs Teacher Admin)
        ====================================================================== -->
        <section id="view-landing" class="max-w-5xl mx-auto">
            <div class="text-center mb-8">
                <span class="inline-block px-4 py-1.5 rounded-full bg-amber-100 text-amber-800 text-xs font-extrabold mb-2">
                    🎓 互動經濟學課堂 · Interactive Economics Classroom
                </span>
                <h2 class="text-2xl sm:text-4xl font-black text-slate-800 tracking-tight">
                    歡迎來到經濟學萌寵學院！
                    <span class="block text-base sm:text-lg font-bold text-amber-600 mt-1">Welcome to Economic Pet Academy</span>
                </h2>
                <p class="text-xs sm:text-sm text-slate-500 max-w-2xl mx-auto mt-2">
                    選擇你的身分進入系統。學生登入後將<span class="font-bold text-rose-600">鎖定為個人專屬帳號</span>（無法切換他人）；老師後台需密碼驗證後方可加扣分。
                </p>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-stretch">
                <!-- Left 8 Cols: Student Login (Roster or New Registration) -->
                <div class="lg:col-span-8 bg-white rounded-3xl shadow-xl p-6 sm:p-8 border border-amber-100 flex flex-col justify-between">
                    <div>
                        <div class="flex items-center justify-between flex-wrap gap-2 mb-4 pb-3 border-b border-slate-100">
                            <div>
                                <h3 class="text-lg sm:text-xl font-black text-slate-800">🐾 我是學生 · Student Login</h3>
                                <p class="text-xs text-slate-500">點擊你的名字或輸入學號姓名登入（登入後將鎖定個人畫面）</p>
                            </div>
                            <span class="px-3 py-1 bg-rose-50 border border-rose-200 text-rose-700 rounded-xl text-[11px] font-bold">
                                🔒 防切換鎖定機制已啟用
                            </span>
                        </div>

                        <!-- Class Roster Grid -->
                        <p class="text-xs font-extrabold text-slate-600 mb-2.5">📋 班級名單快速登入 / Select Your Name from Class Roster:</p>
                        <div id="landing-roster-grid" class="grid grid-cols-1 sm:grid-cols-2 gap-3 max-h-72 overflow-y-auto pr-1 mb-6">
                            <!-- Populated by JS -->
                        </div>
                    </div>

                    <!-- New Student Registration -->
                    <div class="bg-amber-50/80 rounded-2xl p-4 border border-amber-200">
                        <p class="text-xs font-extrabold text-amber-900 mb-2">✨ 不在名單上？輸入姓名建立新學生帳號 / New Student Sign-Up:</p>
                        <div class="flex flex-col sm:flex-row gap-2">
                            <input id="new-student-login-name" type="text" placeholder="請輸入真實姓名 (例如：林小美 Mei Lin)"
                                onkeydown="if(event.key==='Enter') registerAndLoginStudent()"
                                class="flex-1 px-4 py-2.5 rounded-xl border border-amber-300 bg-white text-sm font-bold focus:outline-none focus:ring-2 focus:ring-amber-500">
                            <button onclick="registerAndLoginStudent()" class="px-5 py-2.5 rounded-xl bg-gradient-to-r from-amber-500 to-orange-500 hover:from-amber-600 hover:to-orange-600 text-white font-black text-xs sm:text-sm shadow transition shrink-0">
                                登入並領養寵物 →
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Right 4 Cols: Teacher Admin Portal Card -->
                <div class="lg:col-span-4 bg-gradient-to-br from-indigo-600 via-indigo-700 to-purple-800 rounded-3xl shadow-xl p-6 sm:p-8 text-white flex flex-col justify-between">
                    <div>
                        <div class="w-14 h-14 rounded-2xl bg-white/15 backdrop-blur flex items-center justify-center text-3xl mb-4">
                            👩‍🏫
                        </div>
                        <h3 class="text-xl font-black">老師管理後台</h3>
                        <p class="text-xs text-indigo-200 font-semibold mt-0.5">Teacher Admin Portal</p>
                        <ul class="mt-5 space-y-2.5 text-xs text-indigo-100">
                            <li class="flex items-start gap-2"><span>✅</span><span>根據學生課堂表現快速加扣分或自訂分數與理由</span></li>
                            <li class="flex items-start gap-2"><span>✅</span><span>全班寵物養成進度與積分排行榜即時監控</span></li>
                            <li class="flex items-start gap-2"><span>✅</span><span>發送全班或個別寵物隨機挑戰需求</span></li>
                            <li class="flex items-start gap-2"><span>🔐</span><span>需輸入老師專屬密碼方可進入</span></li>
                        </ul>
                    </div>

                    <button onclick="openTeacherPasscodeModal()" class="mt-6 w-full py-3.5 rounded-2xl bg-white text-indigo-700 hover:bg-indigo-50 font-black text-sm shadow-lg transition transform hover:-translate-y-0.5">
                        🔐 輸入密碼進入老師後台
                    </button>
                </div>
            </div>
        </section>

        <!-- =====================================================================
             2. STUDENT SETUP WIZARD (Step 1: Choose Chibi Pet, Step 2: Econ Name)
        ====================================================================== -->
        <section id="view-student-wizard" class="hidden max-w-6xl mx-auto">
            <div class="bg-white rounded-3xl shadow-xl p-6 sm:p-8 border border-amber-100">
                <div class="flex flex-wrap items-center justify-between gap-3 pb-5 mb-6 border-b border-slate-100">
                    <div>
                        <span class="px-3 py-1 rounded-full bg-amber-100 text-amber-800 text-xs font-extrabold">
                            領養精靈 · Pet Adoption Wizard
                        </span>
                        <h2 class="text-xl sm:text-2xl font-black text-slate-800 mt-1.5">
                            打造你的專屬經濟學萌寵！ <span class="text-sm font-semibold text-slate-500">Create Your Economic Pet</span>
                        </h2>
                    </div>
                    <button id="btn-cancel-wizard" onclick="cancelWizardToRoom()" class="hidden px-4 py-2 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold transition">
                        ← 返回寵物小屋 Back to Room
                    </button>
                </div>

                <!-- STEP 1: CHOOSE ONE OF 12 Q-VERSION CHIBI PETS -->
                <div class="mb-8">
                    <h3 class="text-base sm:text-lg font-black text-slate-800 mb-1">
                        第一步：選擇一隻可愛 Q 版寵物 <span class="text-xs font-normal text-slate-500">/ Step 1: Choose a Cute Chibi Pet (12 Species)</span>
                    </h3>
                    <p class="text-xs text-slate-500 mb-4">每種寵物都有獨特的性格（傲嬌、乖巧、貪吃、活潑、佛系、傲氣），會影響牠們與你互動的台詞喔！</p>

                    <div id="wizard-pet-grid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-3">
                        <!-- Rendered by JS -->
                    </div>
                </div>

                <!-- STEP 2: ECONOMIC CONCEPT + ADJECTIVE = PET NAME -->
                <div class="bg-amber-50/70 rounded-3xl p-5 sm:p-6 border border-amber-200/80">
                    <h3 class="text-base sm:text-lg font-black text-slate-800 mb-1">
                        第二步：選擇經濟學概念 ＋ 喜歡形容詞 ＝ 寵物名字
                        <span class="block text-xs font-normal text-slate-500">Step 2: Economic Concept + Favorite Adjective = Pet's Official Name</span>
                    </h3>

                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mt-4">
                        <!-- Economic Concept Picker -->
                        <div class="bg-white rounded-2xl p-4 border border-amber-100">
                            <label class="block text-xs font-black text-indigo-700 mb-2">📚 選擇有興趣的經濟學概念 / Select Economics Concept:</label>
                            <div id="wizard-concept-chips" class="flex flex-wrap gap-1.5 mb-3">
                                <!-- Rendered by JS -->
                            </div>
                            <div class="pt-2 border-t border-slate-100">
                                <label class="block text-[11px] font-bold text-slate-500 mb-1">➕ 自行加入其他經濟概念 / Custom Concept (中文 / English):</label>
                                <div class="grid grid-cols-2 gap-2">
                                    <input id="custom-concept-zh" type="text" placeholder="中文概念 (如：彈性)" oninput="updateWizardNamePreview()"
                                        class="px-3 py-2 rounded-xl border border-slate-200 text-xs font-bold focus:outline-none focus:border-indigo-500">
                                    <input id="custom-concept-en" type="text" placeholder="English (e.g. Elasticity)" oninput="updateWizardNamePreview()"
                                        class="px-3 py-2 rounded-xl border border-slate-200 text-xs font-bold focus:outline-none focus:border-indigo-500">
                                </div>
                            </div>
                        </div>

                        <!-- Favorite Adjective Picker -->
                        <div class="bg-white rounded-2xl p-4 border border-amber-100">
                            <label class="block text-xs font-black text-pink-600 mb-2">✨ 選擇喜歡的形容詞 / Select Favorite Adjective:</label>
                            <div id="wizard-adj-chips" class="flex flex-wrap gap-1.5 mb-3">
                                <!-- Rendered by JS -->
                            </div>
                            <div class="pt-2 border-t border-slate-100">
                                <label class="block text-[11px] font-bold text-slate-500 mb-1">➕ 自行加入形容詞 / Custom Adjective (中文 / English):</label>
                                <div class="grid grid-cols-2 gap-2">
                                    <input id="custom-adj-zh" type="text" placeholder="中文形容詞 (如：機智的)" oninput="updateWizardNamePreview()"
                                        class="px-3 py-2 rounded-xl border border-slate-200 text-xs font-bold focus:outline-none focus:border-pink-500">
                                    <input id="custom-adj-en" type="text" placeholder="English (e.g. Clever)" oninput="updateWizardNamePreview()"
                                        class="px-3 py-2 rounded-xl border border-slate-200 text-xs font-bold focus:outline-none focus:border-pink-500">
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Live Name Preview & Confirm Button -->
                    <div class="mt-6 bg-white rounded-2xl p-4 sm:p-5 border-2 border-amber-300 flex flex-col sm:flex-row items-center justify-between gap-4">
                        <div class="flex items-center gap-4">
                            <div id="wizard-preview-avatar" class="w-16 h-16 rounded-2xl bg-amber-100 flex items-center justify-center shrink-0"></div>
                            <div>
                                <p class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">寵物專屬命名預覽 · Official Pet Name Preview</p>
                                <p id="wizard-preview-name" class="text-lg sm:text-xl font-black text-slate-800 mt-0.5">精明的機會成本 · Savvy Opportunity Cost</p>
                                <p id="wizard-preview-species" class="text-xs font-bold text-amber-600 mt-0.5"></p>
                            </div>
                        </div>
                        <button onclick="confirmPetAdoption()" class="w-full sm:w-auto px-6 py-3.5 rounded-2xl bg-gradient-to-r from-amber-500 to-orange-500 hover:from-amber-600 hover:to-orange-600 text-white font-black text-sm shadow-lg transition transform hover:-translate-y-0.5">
                            🎉 確認領養並進入小屋 Adopt Pet →
                        </button>
                    </div>
                </div>
            </div>
        </section>

        <!-- =====================================================================
             3. STUDENT PET CARE DASHBOARD (Score-Gated Actions & Habitat)
        ====================================================================== -->
        <section id="view-student-room" class="hidden space-y-6">
            <!-- Top Info Banner (Strictly NO self-scoring!) -->
            <div class="bg-amber-100/90 border-l-4 border-amber-500 text-amber-950 px-4 py-3 rounded-2xl shadow-xs flex flex-wrap items-center justify-between gap-3">
                <div class="flex items-center gap-3">
                    <span class="text-xl">📢</span>
                    <div>
                        <p class="text-xs sm:text-sm font-extrabold">
                            積分僅能由老師根據課堂表現加扣分！累積分數解鎖照護：<span class="text-emerald-800">5分餵食</span>、<span class="text-sky-800">10分洗澡</span>、<span class="text-purple-800">15分玩耍</span>。
                        </p>
                        <p class="text-[11px] text-amber-800">
                            Points are strictly awarded by the Teacher! Reach 5 pts to Feed, 10 pts to Bathe, and 15 pts to Play.
                        </p>
                    </div>
                </div>
                <button onclick="openPetWizardForEdit()" class="px-3.5 py-2 rounded-xl bg-white hover:bg-amber-50 text-amber-800 border border-amber-300 text-xs font-extrabold shadow-xs transition">
                    ✏️ 更換寵物或名字 Edit Pet
                </button>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
                <!-- Left 7 Columns: Scenic Habitat Stage, Pet Animation & Care Buttons -->
                <div class="lg:col-span-7 space-y-5">
                    <!-- Habitat Background Switcher Bar -->
                    <div class="bg-white rounded-2xl p-3 shadow-md border border-slate-100 flex flex-wrap items-center justify-between gap-2">
                        <span class="text-xs font-black text-slate-600 px-2">🏞️ 切換場景 Habitat:</span>
                        <div id="habitat-buttons" class="flex flex-wrap gap-1.5">
                            <!-- Populated by JS -->
                        </div>
                    </div>

                    <!-- Interactive Pet Stage -->
                    <div id="pet-stage-bg" class="bg-meadow rounded-3xl shadow-xl p-6 sm:p-8 relative overflow-hidden min-h-[380px] flex flex-col items-center justify-between border-4 border-white transition-all duration-500">
                        <!-- Decorative Scenery SVG Overlay -->
                        <div id="habitat-scenery-layer" class="absolute inset-0 pointer-events-none"></div>

                        <!-- Top Stage Header: Pet Name & Personality Pill -->
                        <div class="relative z-10 w-full flex flex-wrap items-center justify-between gap-2">
                            <div class="bg-white/90 backdrop-blur-md px-4 py-2 rounded-2xl shadow-sm border border-white">
                                <h2 id="room-pet-name" class="text-base sm:text-lg font-black text-slate-800">精明的機會成本 · Savvy Opportunity Cost</h2>
                                <p id="room-pet-species" class="text-xs font-bold text-amber-600">狐狸 Fox · 傲嬌 Tsundere</p>
                            </div>
                            <div class="bg-slate-900/80 backdrop-blur-md text-white px-4 py-2 rounded-2xl shadow-sm text-right">
