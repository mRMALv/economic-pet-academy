            document.getElementById("room-score-display").innerHTML = `${stu.score} <span class="text-xs font-semibold">分 pts</span>`;

            // Mood & Speech
            const mood = tempMood || (stu.score >= 10 ? "happy" : stu.score < 5 ? "sad" : "neutral");
            document.getElementById("room-pet-avatar").innerHTML = getChibiPetSVG(pet.id, mood);

            if (customSpeech) {
                document.getElementById("pet-speech-zh").textContent = customSpeech.zh;
                document.getElementById("pet-speech-en").textContent = customSpeech.en;
            } else {
                const defaultLine = stu.score < 5 ? pInfo.petLow : pInfo.petHigh;
                document.getElementById("pet-speech-zh").textContent = defaultLine.zh;
                document.getElementById("pet-speech-en").textContent = defaultLine.en;
