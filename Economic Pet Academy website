                logBox.innerHTML = `<p class="text-slate-400 text-center py-4">尚無評分紀錄，快在課堂上積極表現吧！</p>`;
            } else {
                logBox.innerHTML = myLogs.map(l => `
                    <div class="flex items-center justify-between p-2.5 rounded-xl bg-slate-50 border border-slate-100">
                        <div>
                            <p class="font-bold text-slate-700">${escapeHTML(l.reason)}</p>
                            <p class="text-[10px] text-slate-400">${l.time}</p>
                        </div>
