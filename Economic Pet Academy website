            initFirebaseIfConfigured();

            // Check if this browser has a locked student session
            const savedStudentId = sessionStorage.getItem(SESSION_LOCK_KEY) || localStorage.getItem(SESSION_LOCK_KEY);
            if (savedStudentId && appState.students.some(s => s.id === savedStudentId)) {
                enterLockedStudentMode(savedStudentId, true);
            } else {
                renderLandingRoster();
            }

            // Cross-tab LocalStorage real-time sync
            window.addEventListener("storage", (e) => {
                if (e.key === STORAGE_KEY && e.newValue) {
                    try {
                        appState = JSON.parse(e.newValue);
                        refreshCurrentView();
                    } catch (err) {}
                }
            });
        });

        function loadLocalData() {
            const raw = localStorage.getItem(STORAGE_KEY);
            if (raw) {
                try {
                    const parsed = JSON.parse(raw);
                    if (parsed && Array.isArray(parsed.students)) {
                        appState = parsed;
                    }
                } catch (e) {}
            }
        }

        function persistState() {
            localStorage.setItem(STORAGE_KEY, JSON.stringify(appState));
            if (firebaseDbRef) {
                firebaseDbRef.set(appState).catch(err => console.warn("Firebase write error:", err));
            }
        }

        function initFirebaseIfConfigured() {
            const validConfig = (
                typeof firebase !== "undefined" &&
                FIREBASE_CONFIG &&
                FIREBASE_CONFIG.apiKey &&
                FIREBASE_CONFIG.apiKey !== "YOUR_API_KEY" &&
                FIREBASE_CONFIG.databaseURL &&
                !FIREBASE_CONFIG.databaseURL.includes("YOUR_PROJECT_ID")
            );

            if (!validConfig) return;

            try {
                if (!firebase.apps.length) {
                    firebase.initializeApp(FIREBASE_CONFIG);
                }
                firebaseDbRef = firebase.database().ref("econPetAcademyClassroom");
                firebaseDbRef.on("value", (snapshot) => {
                    isFirebaseSynced = true;
                    updateSyncPill(true);
                    const remote = snapshot.val();
                    if (remote && remote.students) {
                        appState.students = Array.isArray(remote.students) ? remote.students : Object.values(remote.students);
                        appState.logs = remote.logs ? (Array.isArray(remote.logs) ? remote.logs : Object.values(remote.logs)) : [];
                        localStorage.setItem(STORAGE_KEY, JSON.stringify(appState));
                        refreshCurrentView();
                    } else {
                        persistState();
                    }
                });
            } catch (e) {
                console.warn("Firebase fallback to LocalStorage:", e);
            }
        }

        function updateSyncPill(online) {
            const dot = document.getElementById("sync-dot");
