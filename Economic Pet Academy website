        function interactCare(actionType) {
            const stu = getLockedStudent();
            if (!stu) return;
            const pet = PET_SPECIES.find(p => p.id === stu.petId) || PET_SPECIES[0];
            const pInfo = PERSONALITIES[pet.personality];

            const thresholds = { pet: 0, feed: 5, bathe: 10, play: 15 };
            const req = thresholds[actionType];

            // Locked threshold check -> trigger personality reminder
            if (stu.score < req) {
                const lockedSpeech = {
                    zh: `🔒 需要達到 ${req} 分才能${actionType === 'feed' ? '餵食' : actionType === 'bathe' ? '洗澡' : '玩耍'}！${pInfo.petLow.zh}`,
                    en: `🔒 Reach ${req} pts first! ${pInfo.petLow.en}`
                };
                triggerAvatarAnim("animate-pet-wiggle");
                renderStudentRoom(lockedSpeech, "sad");
                showToast(`需要至少 ${req} 分才可解鎖！`, `Requires at least ${req} pts!`, "🔒");
                return;
            }

            let speech = pInfo.petHigh;
            let particles = ["💕", "✨", "🌟"];

            if (actionType === "pet") {
                speech = stu.score < 5 ? pInfo.petLow : pInfo.petHigh;
                stu.happiness = Math.min(100, stu.happiness + 4);
                particles = stu.score < 5 ? ["💭", "📚", "✋"] : ["💖", "✨", "🥰"];
                triggerAvatarAnim("animate-pet-wiggle");
            } else if (actionType === "feed") {
                speech = pInfo.feed;
                stu.hunger = Math.min(100, stu.hunger + 18);
                stu.happiness = Math.min(100, stu.happiness + 6);
                particles = ["🍙", "🍣", "🍰", "😋"];
                triggerAvatarAnim("animate-pet-jump");
            } else if (actionType === "bathe") {
                speech = pInfo.bathe;
                stu.cleanliness = Math.min(100, stu.cleanliness + 22);
                stu.happiness = Math.min(100, stu.happiness + 8);
                particles = ["🫧", "✨", "🛁", "💧"];
                triggerAvatarAnim("animate-pet-wiggle");
            } else if (actionType === "play") {
                speech = pInfo.play;
                stu.happiness = Math.min(100, stu.happiness + 20);
                stu.hunger = Math.max(15, stu.hunger - 5);
                particles = ["🎾", "🎉", "⭐", "🎵"];
                triggerAvatarAnim("animate-pet-jump");
            }

            spawnParticles(particles);
            persistState();
            renderStudentRoom(speech, stu.score < 5 && actionType === "pet" ? "sad" : "happy");
        }

        function rollNewPetRequest() {
            const stu = getLockedStudent();
            if (!stu) return;
            const others = WISH_POOL.filter(w => w.id !== stu.wishId);
            const next = others[Math.floor(Math.random() * others.length)];
            stu.wishId = next.id;
            persistState();
            renderStudentRoom();
            showToast("已更新寵物隨機心願！", "New random pet request generated!", "💌");
        }

        function fulfillPetRequest() {
            const stu = getLockedStudent();
            if (!stu) return;
            const wish = WISH_POOL.find(w => w.id === stu.wishId) || WISH_POOL[0];
            if (stu.score < wish.req) return;

            stu.fulfilledCount = (stu.fulfilledCount || 0) + 1;
            stu.happiness = 100;
            stu.hunger = Math.min(100, stu.hunger + 15);
            stu.cleanliness = Math.min(100, stu.cleanliness + 15);

            // Pick a fresh next wish
            const others = WISH_POOL.filter(w => w.id !== wish.id);
            stu.wishId = others[Math.floor(Math.random() * others.length)].id;

            spawnParticles(["🏆", "🎉", "💖", "👑", "✨"]);
            triggerAvatarAnim("animate-pet-jump");
            persistState();

            const celebSpeech = {
                zh: `太棒了！心願「${wish.zh}」達成啦！主人你簡直是經濟學之神！`,
                en: `Woohoo! Wish "${wish.en}" fulfilled! Master, you are an Economics superstar!`
            };
            renderStudentRoom(celebSpeech, "happy");
            showToast("成功滿足寵物心願！獲得榮譽徽章！", "Pet wish fulfilled! Celebration!", "🏆");
        }

        function triggerAvatarAnim(animClass) {
            const el = document.getElementById("room-pet-avatar");
            el.classList.remove("animate-pet-float", "animate-pet-jump", "animate-pet-wiggle");
            void el.offsetWidth;
            el.classList.add(animClass);
            setTimeout(() => {
                el.classList.remove("animate-pet-jump", "animate-pet-wiggle");
                el.classList.add("animate-pet-float");
            }, 900);
        }

        function spawnParticles(emojis) {
            const container = document.getElementById("particle-container");
            container.innerHTML = "";
            emojis.forEach((em, idx) => {
                const span = document.createElement("span");
                span.textContent = em;
                span.className = "absolute text-2xl sm:text-3xl animate-particle select-none";
                span.style.left = `${20 + idx * 18}%`;
                span.style.top = `${30 + (idx % 2) * 15}%`;
                span.style.animationDelay = `${idx * 0.1}s`;
                container.appendChild(span);
            });
        }

